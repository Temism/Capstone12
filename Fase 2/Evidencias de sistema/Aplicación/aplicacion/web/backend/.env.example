# Configuración de Base de Datos MySQL Local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql_aqui
DB_NAME=plataforma_educativa

# Configuración del Servidor y Seguridad JWT
API_PORT=8000
JWT_SECRET=reemplazar_con_clave_secreta_aleatoria_produccion
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Reconocimiento de Voz STT (Opcional: o usar backend/deepgram_api_key.txt ignorado en Git)
DEEPGRAM_API_KEY=tu_deepgram_api_key_aqui
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=es

# Síntesis de Voz TTS (Opcional: o usar backend/elevenlabs_secret.txt ignorado en Git)
ELEVENLABS_API_KEY=tu_elevenlabs_api_key_aqui

# Evaluador Pedagógico con IA (Opcional: o usar backend/gemini_api_key.txt ignorado en Git)
GEMINI_API_KEY=tu_gemini_api_key_aqui
